{
  "name": "@local/dsh-dafeiyu-wonder-reading",
  "version": "2.0.0",
  "private": true,
  "description": "大肥鱼的不思议阅读：记录 BLACK SOULS II 的对话（带说话人），需要时交给 agent 阅读或写报告。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "widget.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
