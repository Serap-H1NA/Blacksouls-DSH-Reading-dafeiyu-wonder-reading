# 大肥鱼的不思议阅读：记录黑魂2 的对话（带说话人），按需交给 agent 阅读或写报告。
# 读的是游戏桥接器写的 <gameDir>/BridgeRuntime/state/*.json。
#
# 用法：复制本文件为 cordis.patch.yml，再把 gameDir / dataDir 改成你自己的路径。
# 下面每个键都可省略。
- insert:
    - id: dafeiyu-wonder-reading
      name: '@local/dsh-dafeiyu-wonder-reading'
      config:
        # 游戏副本目录：里面有 BridgeRuntime/state/*.json
        gameDir: '<你的游戏目录>'
        # 阅读记录写到哪
        dataDir: '<你的数据目录，例如 <工作区>/阅读记录>'
        # 阅读报告写到哪。留空时，按「生成阅读报告」会提示先设置。
        reportDir: ''
        # 默认不自动发送：记录免费，交给 agent 的那一步由人按。
        autoAnalyze: false
        # 随 DSH 启动悬浮窗（pythonw widget.py）。
        widgetAutoStart: true
